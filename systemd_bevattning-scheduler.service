[Unit]
Description=Bevattning Auto-Watering Scheduled Task
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kamp
Group=kamp
WorkingDirectory=/home/kamp/fotbollsplan-bevattning
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/kamp/fotbollsplan-bevattning/.venv/bin/python3 /home/kamp/fotbollsplan-bevattning/bevattning_scheduler.py --run-now --auto-start
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bevattning-scheduler

[Install]
WantedBy=multi-user.target
