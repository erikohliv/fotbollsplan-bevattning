[Unit]
Description=Bevattning Controller - System 2.0 (Weather + PLC Control)
After=network-online.target bevattning-api.service
Wants=network-online.target

[Service]
Type=simple
User=kamp
Group=kamp
WorkingDirectory=/home/kamp/fotbollsplan-bevattning
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/kamp/fotbollsplan-bevattning/api_.env
ExecStart=/home/kamp/fotbollsplan-bevattning/.venv/bin/python3 /home/kamp/fotbollsplan-bevattning/bevattning_controller.py --loop --interval 60 --read-markfukt
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
