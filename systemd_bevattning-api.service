[Unit]
Description=Bevattning FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
User=kamp
Group=kamp
WorkingDirectory=/home/kamp/fotbollsplan-bevattning
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/kamp/fotbollsplan-bevattning/api_.env
ExecStart=/home/kamp/fotbollsplan-bevattning/.venv/bin/uvicorn api_main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target