[Unit]
Description=Bevattning Display Manager - System 2.0
After=network-online.target bevattning-api.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/fotbollsplan-bevattning
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/pi/fotbollsplan-bevattning/api_.env
ExecStart=/home/pi/fotbollsplan-bevattning/.venv/bin/python3 /home/pi/fotbollsplan-bevattning/display_manager.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
