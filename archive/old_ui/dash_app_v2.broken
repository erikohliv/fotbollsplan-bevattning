@app.callback(
    [Output('pump-animation', 'children'),
     Output('pump-status-text', 'children')],
    [Input('hidden-process-data', 'children')]
)
def update_pump_status(process_json):
    """Uppdatera pump-status med animation"""
    if not process_json:
        return "⚫", "Laddar..."
    
    try:
        data = json.loads(process_json)
        if data.get('ok') and 'pump' in data:
            pump = data['pump']
            if pump['on']:
                animation = html.Div("💧", className='pump-active')
                status = html.Span([
                    html.Span("PUMP AKTIV", style={'color': COLORS['pump_on'], 'fontWeight': 'bold'}),
                    html.Br(),
                    html.Span(f"Status: {pump.get('status', 'OK')}", style={'fontSize': '14px'})
                ])
                return animation, status
            else:
                return "⚫", html.Span("Pump avstängd", style={'color': COLORS['pump_off']})
    except Exception as e:
        logger.error(f"Error updating pump: {e}")
    
    return "⚫", "Fel vid hämtning"


                             style={'fontSize': '20px', 'color': COLORS['secondary']})
                ], style={'marginBottom': '10px'}),
                             style={'fontSize': '20px', 'color': COLORS['accent']})
                ])
            ])
    except Exception as e:
        logger.error(f"Error updating sensors: {e}")
    


@app.callback(
    Output('error-status', 'children'),
    [Input('hidden-process-data', 'children')]
def update_error_status(process_json):
    """Uppdatera felstatus"""
    if not process_json:
        return "Laddar..."
    
    try:
        data = json.loads(process_json)
        if data.get('ok'):
            block = data.get('block_status', {})
            error_details = data.get('error_details', {})
            
            if block.get('blocked'):
                return html.Div([
                    html.H3("⚠️ Blockering", style={'color': COLORS['danger'], 'margin': '0 0 10px 0'}),
                    html.Div(block.get('text', 'Okänt fel'), style={'fontWeight': 'bold'}),
                    html.Div(block.get('explanation', ''), style={'fontSize': '14px', 'marginTop': '5px'})
                ], style={
                    'padding': '15px',
                    'backgroundColor': '#ffebee',
                    'borderRadius': '8px',
                    'borderLeft': f'4px solid {COLORS["danger"]}'
                })
            
            # Check for any active errors
            active_errors = [e for e in error_details.values() if e.get('active')]
            if active_errors:
                return html.Div([
                    html.H3("⚠️ Varningar", style={'color': COLORS['warning'], 'margin': '0 0 10px 0'}),
                    html.Div([
                        html.Div(f"• {err.get('text', 'Okänt')}", style={'marginBottom': '5px'})
                        for err in active_errors
                    ])
                ])
            
            return html.Div([
                html.Span("✅ ", style={'fontSize': '24px'}),
                html.Span("System OK", style={'fontWeight': 'bold', 'color': COLORS['success']})
            ])
    except Exception as e:
        logger.error(f"Error in error status: {e}")
    
    return "Fel vid hämtning"


