    [State('zone-modal', 'style')]
)
def toggle_zone_modal(clickData, close_clicks, current_style):
# ===== KNAPPAR OCH AKTIVITETSLOGG CALLBACKS =====
@app.callback(
    Output('modal-feedback', 'children'),
    [Input('btn-zone-start', 'n_clicks'),
     Input('btn-zone-stop', 'n_clicks'),
     Input('btn-timer-5', 'n_clicks'),
     Input('btn-timer-10', 'n_clicks'),
     Input('btn-timer-15', 'n_clicks'),
     Input('btn-timer-30', 'n_clicks'),
     Input('btn-stop-all', 'n_clicks')],
    [State('store-selected-zone', 'data')]
)
def handle_zone_controls(start_clicks, stop_clicks, t5, t10, t15, t30, stop_all_clicks, selected_zone):
    """Hantera zon-kontroller"""
    ctx = callback_context
    
    if not ctx.triggered or selected_zone is None:
        return ""
    
    trigger_id = ctx.triggered[0]['prop_id'].split('.')[0]
    
    # Användarnamn (TODO: hämta från session/inloggning)
    user = "admin"  # Placeholder - kommer från inloggning senare
    
    try:
        if trigger_id == 'btn-zone-start':
            result = make_api_request("/command/manual", method="POST", json_data={"zone": selected_zone, "user": user})
            if result.get('ok'):
                return html.Div([
                    html.Span("✅ ", style={'fontSize': '20px'}),
                    f"Zon {selected_zone} startad!"
                ], style={'color': COLORS['success'], 'padding': '10px', 'backgroundColor': '#e8f5e9', 'borderRadius': '4px'})
            else:
                return html.Div([
                    html.Span("❌ ", style={'fontSize': '20px'}),
                    f"Fel: {result.get('error', 'Okänt fel')}"
                ], style={'color': COLORS['danger'], 'padding': '10px', 'backgroundColor': '#ffebee', 'borderRadius': '4px'})
        
        elif trigger_id == 'btn-zone-stop' or trigger_id == 'btn-stop-all':
            result = make_api_request("/command/stop", method="POST", json_data={"user": user})
            if result.get('ok'):
                return html.Div([
                    html.Span("✅ ", style={'fontSize': '20px'}),
                    "Bevattning stoppad!"
                ], style={'color': COLORS['success'], 'padding': '10px', 'backgroundColor': '#e8f5e9', 'borderRadius': '4px'})
        
        elif trigger_id.startswith('btn-timer'):
            minutes = int(trigger_id.split('-')[-1])
            return html.Div([
                html.Span("⏱️ ", style={'fontSize': '20px'}),
                f"Timer satt: {minutes} minuter (TODO: Implementera schemaläggning)"
            ], style={'color': COLORS['info'], 'padding': '10px', 'backgroundColor': '#e3f2fd', 'borderRadius': '4px'})
    
    except Exception as e:
        logger.error(f"Error in zone control: {e}")
        return html.Div([
            html.Span("❌ ", style={'fontSize': '20px'}),
            f"Fel: {str(e)}"
        ], style={'color': COLORS['danger'], 'padding': '10px', 'backgroundColor': '#ffebee', 'borderRadius': '4px'})
    
    return ""


