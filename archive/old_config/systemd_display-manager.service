[Unit]
Description=Fotbollsplan Display Manager
After=network.target bevattning-api.service
Requires=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/fotbollsplan-bevattning
Environment="PATH=/home/pi/fotbollsplan-bevattning/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/pi/fotbollsplan-bevattning/.venv/bin/python3 /home/pi/fotbollsplan-bevattning/display_manager.py --enable-scheduler --schedule-hour 1 --schedule-minute 0
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
