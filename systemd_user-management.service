[Unit]
Description=User Management Web UI
After=network-online.target bevattning-api.service
Wants=network-online.target

[Service]
Type=simple
User=kamp
Group=kamp
WorkingDirectory=/home/kamp/fotbollsplan-bevattning
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/kamp/fotbollsplan-bevattning/api_.env
ExecStart=/home/kamp/fotbollsplan-bevattning/.venv/bin/python3 /home/kamp/fotbollsplan-bevattning/user_management_web.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

